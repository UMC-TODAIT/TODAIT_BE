DB_URL=jdbc:mysql://{YOUR_DB_HOST}:3306/{YOUR_DB_NAME}
DB_USER={YOUR_DB_USER_NAME}
DB_PW={YOUR_DB_PASSWORD}

REDIS_HOST={YOUR_REDIS_HOST_NAME}
REDIS_PORT=6379
REDIS_PASSWORD={YOUR_REDIS_PASSWORD}

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM={YOUR_EMAIL_ADDRESS}
MAIL_USERNAME={YOUR_EMAIL_ADDRESS}
MAIL_PASSWORD={YOUR_SMTP_EMAIL_PASSWORD}
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_CONNECTIONTIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITETIMEOUT=5000

COURSE_DRAFT_EXPIRATION_HOURS=24

EMAIL_VERIFICATION_CODE_TTL_MINUTES=5
EMAIL_VERIFICATION_VERIFIED_TTL_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_VERIFY_FAILURE_TTL_MINUTES=5
EMAIL_VERIFICATION_MAX_VERIFY_FAILURES=5

JWT_SECRET={YOUR_JWT_SECRET_CODE}

KAKAO_REST_API_KEY={YOUR_KAKAO_API_KEY}
KAKAO_REST_API_SECRET={YOUR_KAKAO_SECRET_KEY}
KAKAO_REDIRECT_URI={YOUR_KAKAO_REDIRECT_URI}
